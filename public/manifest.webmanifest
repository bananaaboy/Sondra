{
  "name": "Sondra — Medienwerkzeuge, die lokal laufen",
  "short_name": "Sondra",
  "description": "Konvertieren, Spuren trennen, normalisieren und sampeln — vollständig im Browser, ohne Upload.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2eee4",
  "theme_color": "#f2eee4",
  "lang": "de",
  "categories": [
    "utilities",
    "productivity",
    "music"
  ],
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/ogg": [
          ".ogg",
          ".oga",
          ".opus"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "audio/aac": [
          ".aac"
        ],
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/webm": [
          ".webm"
        ],
        "video/x-matroska": [
          ".mkv"
        ],
        "video/quicktime": [
          ".mov"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": [
            "audio/*",
            "video/*"
          ]
        }
      ]
    }
  }
}