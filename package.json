{
  "name": "sondra",
  "private": true,
  "version": "1.1.22",
  "license": "MIT",
  "type": "module",
  "description": "Sondra — a fully client-side media studio. Download, convert, separate, normalize and sample audio entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "dev:service": "node scripts/dev-service.mjs",
    "android:icons": "node scripts/android-icons.mjs",
    "typecheck": "tsc -b --noEmit",
    "verify:loudness": "esbuild scripts/verify-loudness.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-loudness.mjs && node node_modules/.verify-loudness.mjs",
    "verify:convert": "esbuild scripts/verify-convert.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-convert.mjs && node node_modules/.verify-convert.mjs",
    "verify:tempo": "esbuild scripts/verify-tempo.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-tempo.mjs && node node_modules/.verify-tempo.mjs",
    "verify": "npm run verify:changelog && npm run verify:devices && npm run verify:loudness && npm run verify:tempo && npm run verify:harmony && npm run verify:resolve && npm run verify:extractors && npm run verify:services && npm run verify:ytdlp && npm run verify:download && npm run verify:anytype && npm run verify:merkliste && npm run verify:discord && npm run verify:drive && npm run verify:google-token && npm run verify:intro && npm run verify:folder",
    "verify:harmony": "esbuild scripts/verify-harmony.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-harmony.mjs && node node_modules/.verify-harmony.mjs",
    "verify:resolve": "node scripts/verify-resolve.mjs",
    "verify:extractors": "node scripts/verify-extractors.mjs",
    "verify:services": "esbuild scripts/verify-services.mjs --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-services.mjs && node node_modules/.verify-services.mjs",
    "verify:ytdlp": "node scripts/verify-ytdlp.mjs",
    "verify:download": "esbuild scripts/verify-download.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-download.mjs && node node_modules/.verify-download.mjs",
    "verify:anytype": "esbuild scripts/verify-anytype.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-anytype.mjs && node node_modules/.verify-anytype.mjs",
    "verify:discord": "node scripts/verify-discord.mjs",
    "verify:intro": "esbuild scripts/verify-intro.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-intro.mjs && node node_modules/.verify-intro.mjs",
    "verify:folder": "esbuild scripts/verify-folder.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-folder.mjs && node node_modules/.verify-folder.mjs",
    "verify:drive": "esbuild scripts/verify-drive.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-drive.mjs && node node_modules/.verify-drive.mjs",
    "verify:merkliste": "esbuild scripts/verify-merkliste-features.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-merkliste.mjs && node node_modules/.verify-merkliste.mjs",
    "dl": "node scripts/dl.mjs",
    "ytdlp": "node public/sondra-ytdlp.mjs",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "node desktop/main.mjs",
    "verify:google-token": "node scripts/verify-google-token.mjs",
    "verify:changelog": "node scripts/verify-changelog.mjs",
    "verify:devices": "esbuild scripts/verify-devices.mts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.verify-devices.mjs && node node_modules/.verify-devices.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.3.0",
    "hls.js": "^1.7.3",
    "onnxruntime-web": "^1.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tone": "^15.1.22",
    "wavesurfer.js": "^7.9.5",
    "youtubei.js": "^18.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "overrides": {
    "onnxruntime-node": "file:./stubs/onnxruntime-node",
    "sharp": "file:./stubs/sharp"
  }
}
